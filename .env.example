# ==========================================
# HomeSphere - Environment Configuration Template
# ==========================================
# NOTE: Do NOT put real secrets in this file. Copy to .env.local or appsettings.Development.json for local dev.

# --- Backend (ASP.NET Core WebApi) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5100

# Database (PostgreSQL)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=homesphere_dev;Username=postgres;Password=postgres

# JWT Authentication
Jwt__Secret=development_super_secret_jwt_key_at_least_32_chars_long!
Jwt__Issuer=HomeSphereApi
Jwt__Audience=HomeSphereWeb
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# Mock Payment Webhook Secret
Payment__WebhookSecret=dev_mock_webhook_secret_key_12345

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:5100
NEXT_PUBLIC_APP_NAME="HomeSphere"
NEXT_PUBLIC_APP_URL=http://localhost:3000
